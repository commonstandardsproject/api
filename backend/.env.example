# Dev / staging environment knobs. Copy to `.env` and fill in.
# `mix phx.server` reads neither — your shell does (`set -a; . .env`),
# or use a launcher like `direnv`.

# ─── Mongo ─────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017/csp
# Prod  Atlas: mongodb+srv://<user>:<pass>@<host>/<db>?appName=production
MONGO_URL=mongodb://localhost:27017/csp
MONGO_POOL_SIZE=10

# Set ONLY for parity diffs against a read-only replica. Disables the
# `findAndModify` request-count bump on auth so the auth path works
# without write privileges. Refuses to boot under MIX_ENV=prod. NEVER set
# this for the production deploy.
# MONGO_READ_ONLY=1

# ─── Phoenix ───────────────────────────────────────────────────────────
SECRET_KEY_BASE=
PHX_HOST=localhost
PORT=4000

# ─── Auth0 (prod-only — see lib/csp_api_web/plugs/jwt_auth.ex) ─────────
AUTH0_CLIENT_SECRET=
AUTH0_CLIENT_ID=

# ─── Algolia (prod-only — index updates from StandardSets.upsert/1) ────
ALGOLIA_APPLICATION_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX=common-standards-project

# ─── Postmark (prod-only — PR status-change emails) ────────────────────
POSTMARK_API_TOKEN=
POSTMARK_FROM_ADDRESS=

# ─── Contract-tests / Phoenix dev ──────────────────────────────────────
# Used by the Python contract suite — see ../contract_tests/.
CSP_API_KEY=
